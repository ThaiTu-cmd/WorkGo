# ============================================================
# WorkGo — .env.example
# Commit file này lên git. Copy thành .env và điền giá trị thật.
# ============================================================

# ==============================
# PostgreSQL (Shared credentials)
# ==============================
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# ==============================
# Identity Service
# ==============================
IDENTITY_DB=identity_db
IDENTITY_PORT=8081
JWT_SIGNER_KEY=your_jwt_signer_key_here
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ==============================
# API Gateway
# ==============================
GATEWAY_PORT=8888

# ==============================
# Catalog Service
# ==============================
CATALOG_DB=catalog_db
CATALOG_PORT=8082

# ==============================
# Order Service
# ==============================
ORDER_DB=order_db
ORDER_PORT=8083

# ==============================
# Payment Service
# ==============================
PAYMENT_DB=payment_db
PAYMENT_PORT=8084
