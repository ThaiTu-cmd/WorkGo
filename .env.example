# ============================================================
# WorkGo — .env.example
# Commit file này lên git. Copy thành .env và điền giá trị thật.
# ============================================================

# ==============================
# PostgreSQL (Shared credentials)
# ==============================
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# ==============================
# Identity Service
# ==============================
IDENTITY_DB=identity_db
IDENTITY_PORT=8081
JWT_SIGNER_KEY=your_jwt_signer_key_here
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ==============================
# API Gateway
# ==============================
GATEWAY_PORT=8888

# ==============================
# Communication Service (local single-node replica set)
# ==============================
COMMUNICATION_PORT=8086
COMMUNICATION_BIND_ADDRESS=127.0.0.1
COMMUNICATION_DB=communication_db
COMMUNICATION_DB_PORT=27017
# Optional full URI override; defaults in application.yaml follow DB/port above.
# directConnection supports the local Docker port mapping; not a production topology.
# COMMUNICATION_MONGODB_URI=mongodb://localhost:27017/communication_db?replicaSet=rs0&directConnection=true
COMMUNICATION_AUTO_INDEX_CREATION=false
# Set container DNS URLs when Gateway runs in Docker instead of on the host.
COMMUNICATION_HTTP_URL=http://localhost:8086
COMMUNICATION_WS_URL=ws://localhost:8086
JOB_SERVICE_URL=http://localhost:8085/job
COMMUNICATION_WS_ALLOWED_ORIGINS=http://localhost:5173
COMMUNICATION_WS_CONNECT_TIMEOUT_MS=10000
COMMUNICATION_WS_HEARTBEAT_MS=10000
COMMUNICATION_WS_REVALIDATE_INTERVAL_MS=60000
COMMUNICATION_WS_MAINTENANCE_INTERVAL_MS=1000
COMMUNICATION_WS_VALIDATION_TIMEOUT_MS=8000
COMMUNICATION_WS_VALIDATION_THREADS=4
COMMUNICATION_WS_VALIDATION_QUEUE_CAPACITY=100
COMMUNICATION_WS_MAX_PENDING_HANDSHAKES=100
COMMUNICATION_WS_MAX_SESSIONS=1000
COMMUNICATION_WS_MAX_SUBSCRIPTIONS=100
COMMUNICATION_WS_MESSAGE_SIZE_LIMIT=65536
COMMUNICATION_CLIENT_CONNECT_TIMEOUT_MS=2000
COMMUNICATION_CLIENT_READ_TIMEOUT_MS=5000

# ==============================
# Catalog Service
# ==============================
CATALOG_DB=catalog_db
CATALOG_DB_PORT=5434
CATALOG_PORT=8082

# ==============================
# Order Service
# ==============================
ORDER_DB=order_db
ORDER_DB_PORT=5435
ORDER_PORT=8083

# ==============================
# Job Service
# ==============================
JOB_DB=job_db
JOB_DB_PORT=5437
JOB_PORT=8085
IDENTITY_SERVICE_URL=http://localhost:8081/identity
CATALOG_SERVICE_URL=http://localhost:8082/catalog

# ==============================
# Payment Service
# ==============================
PAYMENT_DB=payment_db
PAYMENT_DB_PORT=5436
PAYMENT_PORT=8084
ORDER_SERVICE_URL=http://localhost:8083/order
PAYMENT_RESULT_URL=http://localhost:3000/payment/result

# Shared secret cho cac endpoint /internal/** giua cac service
INTERNAL_API_KEY=your_internal_key_here

# VNPay sandbox
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_RETURN_URL=http://localhost:8888/api/v1/payment/gateway/vnpay/return

# MoMo sandbox
MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_REDIRECT_URL=http://localhost:8888/api/v1/payment/gateway/momo/return
MOMO_IPN_URL=https://your-ngrok-domain/api/v1/payment/gateway/momo/ipn
