# WorkGo Android — backend chosen at build time.
# Copy to .env.local (not committed) and pick one line.
#
# | Runs on                           | EXPO_PUBLIC_API_BASE_URL                  | WORKGO_ALLOW_HTTP     |
# |-----------------------------------|-------------------------------------------|-----------------------|
# | Emulator, backend on this laptop  | http://10.0.2.2:8888/api/v1 (default)     | 1 for a release APK   |
# | Phone on the same Wi-Fi           | http://<laptop LAN IP>:8888/api/v1        | 1 for a release APK   |
# | Phone on another network (tunnel) | https://<ngrok/cloudflared URL>/api/v1    | unset                 |
# | Deployed server (later)           | https://<domain>/api/v1                   | unset                 |
#
# Dev builds (npx expo run:android) already allow HTTP; the flag only matters for release APKs.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8888/api/v1
# WORKGO_ALLOW_HTTP=1
